{
  "name": "claude-route-switch",
  "version": "0.2.0",
  "description": "Give each Claude Agent SDK / Claude Code conversation its own egress: the machine login, named subscription accounts, or Anthropic-compatible API relays from a named pool. Optional local USD wallet by token estimate.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./env": "./src/env.js",
    "./pricing": "./src/pricing.js"
  },
  "bin": {
    "claude-route": "./bin/claude-route.js"
  },
  "files": [
    "src",
    "bin",
    "examples",
    "config.example.json",
    "README.md",
    "docs",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "claude",
    "anthropic",
    "claude-agent-sdk",
    "claude-code",
    "api-relay",
    "base-url",
    "route-switch"
  ],
  "license": "MIT",
  "author": "mumu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yolilin642-byte/claude-route-switch.git"
  },
  "homepage": "https://github.com/yolilin642-byte/claude-route-switch#readme",
  "bugs": {
    "url": "https://github.com/yolilin642-byte/claude-route-switch/issues"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "cli": "node bin/claude-route.js"
  }
}
